# Configuration du serveur
PORT=3000
NODE_ENV=production

# Origines Frontend autorisees (separees par des virgules en production)
FRONTEND_URL=http://localhost:3001,https://your-frontend-domain.vercel.app

# Identifiants Supabase (Projet PostgreSQL & Auth)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# URL de redirection pour la reinitialisation de mot de passe
PASSWORD_RESET_REDIRECT_URL=https://your-frontend-domain.vercel.app/auth/reset-password
