# Configuration du serveur
PORT=3000
NODE_ENV=production

# Mettre 1 seulement si le backend est derriere un unique reverse proxy de confiance.
TRUST_PROXY=1

# Origines Frontend autorisees (separees par des virgules en production)
# Le frontend demarre sur le port 3333 en local (voir frontend/package.json, script "dev").
FRONTEND_URL=http://localhost:3333,https://your-frontend-domain.vercel.app

# Identifiants Supabase (Projet PostgreSQL & Auth)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# URL de redirection pour la reinitialisation de mot de passe
PASSWORD_RESET_REDIRECT_URL=https://your-frontend-domain.vercel.app/auth/reset-password

# Passerelles de paiement (Optionnel en dev / simulation automatique si absent)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Service d'emails transactionnels (Brevo, Resend, Sendgrid ou SMTP standard)
# En dev/test, si ces variables sont absentes, les emails sont automatiquement simules dans les logs
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-password
SMTP_FROM="MyTicket Billetterie" <no-reply@your-domain.com>

